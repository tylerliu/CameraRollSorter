    "Done" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完成"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完成"
          }
        }
      }
    },
    "Each photo is compared with its closest neighbors by capture time, before or after it. Matching links join into larger groups, which can contain more than five photos. A chain of matches may connect endpoints that are not directly similar." : {
      "comment" : "A description of how photos are compared in the Low-aesthetic feature.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每张照片会与拍摄时间上最接近的前后照片比对。匹配的连接会合并为更大的组，可能包含五张以上的照片。一连串的匹配可能连接起并不直接相似的两端。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每張相片會與拍攝時間上最接近的前後相片比對。匹配的連接會合併為更大的組，可能包含五張以上的相片。一連串的匹配可能連接起並不直接相似的兩端。"
          }
        }
      }
    },
    "Each scan pauses once it has this many results below your current position, so the app stays responsive; scrolling loads more. Applies to Similar photos (groups), Live → Still, and Low-aesthetic (photos). Default 200." : {
      "comment" : "A description of the buffer value for the number of results to keep in view.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次扫描在你当前位置下方达到此数量的结果后暂停，以保持应用流畅；滚动可加载更多。适用于相似照片（组）、实况转静止和低质量照片（张）。默认 200。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次掃描在你目前位置下方達到此數量的結果後暫停，以保持 App 流暢；捲動可載入更多。適用於相似相片（組）、實況轉靜止和低品質相片（張）。預設 200。"
          }
        }
      }
    },
    "Favorite" : {
      "comment" : "A label for whether a photo is marked as a favorite.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
